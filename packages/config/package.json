{
  "name": "@nailyjs/config",
  "type": "module",
  "version": "2.0.3",
  "description": "Config module for naily.js.",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup -w",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@nailyjs/ioc": "workspace:*",
    "@types/jexl": "^2.3.4",
    "c12": "^2.0.1",
    "jexl": "^2.3.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
