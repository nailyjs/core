{
  "name": "@nailyjs/rpc",
  "type": "module",
  "version": "2.0.5",
  "description": "Powerful JSON RPC 2.0 backend for Node.js",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js",
      "require": "./dist/axios.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup -w",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@nailyjs/backend": "workspace:*",
    "@nailyjs/ioc": "workspace:*",
    "axios": "^1.7.7",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.17.21",
    "tsup": "^8.3.0"
  }
}
