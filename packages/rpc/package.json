{
  "name": "@nailyjs/rpc",
  "type": "module",
  "version": "1.0.2",
  "description": "Rpc package for naily.js",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "license": "MIT",
  "homepage": "https://github.com/nailyjs/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nailyjs/core.git"
  },
  "bugs": {
    "url": "https://github.com/nailyjs/core/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./axios": {
      "types": "./dist/axios.d.ts",
      "import": "./dist/axios.js",
      "require": "./dist/axios.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@nailyjs/backend": "workspace:*",
    "@nailyjs/ioc": "workspace:*",
    "axios": "^1.7.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
