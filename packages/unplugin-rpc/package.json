{
  "name": "unplugin-rpc",
  "type": "module",
  "version": "2.0.19",
  "description": "Bring naily.js JSON-RPC 2.0 to your vite project and more.",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js",
      "require": "./dist/nuxt.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "import": "./dist/astro.js",
      "require": "./dist/astro.cjs"
    },
    "./dist/*": "./dist/*"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup -w",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@nailyjs/backend": "workspace:*",
    "@nailyjs/ioc": "workspace:*",
    "@nailyjs/rpc": "workspace:*",
    "@nuxt/kit": "^3.14.0",
    "@nuxt/schema": "^3.14.0",
    "@rollup/pluginutils": "^5.1.3",
    "@swc/core": "^1.9.1",
    "defu": "^6.1.4",
    "kleur": "^4.1.5",
    "load-tsconfig": "^0.2.5",
    "typeorm": "^0.3.20",
    "unplugin": "^1.15.0",
    "vite": "^5.4.10"
  },
  "devDependencies": {
    "tsup": "^8.3.0"
  }
}
