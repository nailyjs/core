{
  "name": "@nailyjs/monorepo",
  "type": "module",
  "private": true,
  "description": "Create a lib monorepo with antfu's code style",
  "author": "Naily Zero <zero@naily.cc> (https://naily.cc)",
  "keywords": [
    "es-project-template"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:ioc": "pnpm -F @nailyjs/ioc build",
    "build:rpc": "pnpm -F @nailyjs/rpc build",
    "build:unplugin-rpc": "pnpm -F unplugin-rpc build",
    "build:backend": "pnpm -F @nailyjs/backend build",
    "play:rpc": "pnpm -F rpc-playground dev",
    "play:build": "pnpm -F rpc-playground build",
    "lint": "eslint .",
    "postinstall": "npx simple-git-hooks",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest --coverage",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^3.7.3",
    "@celljs/rpc": "^3.1.1",
    "@shikijs/transformers": "^1.22.1",
    "@shikijs/vitepress-twoslash": "^1.22.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.5",
    "@types/ssh2-sftp-client": "^9.0.4",
    "@vitest/coverage-v8": "2.1.3",
    "@vitest/ui": "2.1.3",
    "bumpp": "^9.7.1",
    "commander": "^12.1.0",
    "eslint": "^9.12.0",
    "js-yaml": "^4.1.0",
    "less": "^4.2.0",
    "lint-staged": "^15.2.10",
    "p-limit": "^6.1.0",
    "simple-git-hooks": "^2.11.1",
    "ssh2-sftp-client": "^11.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typedoc": "^0.26.10",
    "typedoc-material-theme": "^1.1.0",
    "typescript": "^5.6.3",
    "unocss": "^0.63.6",
    "unplugin-swc": "^1.5.1",
    "vite": "^5.4.2",
    "vitepress": "^1.4.1",
    "vitest": "^2.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint . --fix"
  }
}
